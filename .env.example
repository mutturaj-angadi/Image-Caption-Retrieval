# Copy to .env (never commit .env). All values are optional; defaults shown.

# Directory that holds one sub-folder per trained model (checkpoints + index).
NCIR_ARTIFACTS_DIR=artifacts

# Processed dataset metadata written by scripts/prepare_data.py
NCIR_METADATA_PATH=data/processed/metadata.json

# Root folder that contains the image files referenced by the metadata.
# Leave empty to use the images_root stored in the metadata file.
NCIR_IMAGES_ROOT=

# Folder with evaluation JSON files and dataset statistics.
NCIR_REPORTS_DIR=reports
NCIR_STATS_PATH=data/processed/stats.json

# Comma-separated list of browser origins allowed to call the API (local dev).
NCIR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Search limits
NCIR_MAX_TOP_K=100
NCIR_MAX_QUERY_CHARS=300

# Log level: DEBUG, INFO, WARNING, ERROR
NCIR_LOG_LEVEL=INFO

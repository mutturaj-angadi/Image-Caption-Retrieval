# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.pytest-tmp/
.mypy_cache/
*.egg-info/

# Environment / secrets
.env
.env.*
!.env.example

# Data, features, checkpoints and indexes (large; never commit)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/smoke/
artifacts/*
!artifacts/.gitkeep
*.pt
*.pth
*.npy
*.npz
*.faiss
*.index

# Generated reports (the verified metrics JSON files are small and may be committed deliberately)
reports/figures/*
!reports/figures/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
